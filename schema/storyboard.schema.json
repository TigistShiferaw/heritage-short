{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "type": "object",
  "required": ["title", "language", "narration_voice", "style", "characters", "music", "shots", "end_card"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "logline": { "type": "string" },
    "language": { "type": "string", "description": "BCP-47 code of the narration, e.g. am" },
    "narration_voice": { "type": "string", "description": "Gemini TTS prebuilt voice name" },
    "style": {
      "type": "object", "required": ["prompt"], "additionalProperties": false,
      "properties": { "prompt": { "type": "string", "minLength": 10 }, "negative": { "type": "string" } }
    },
    "characters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "description"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "description": { "type": "string", "minLength": 10 },
          "reference_image": { "type": "string" }
        }
      }
    },
    "music": {
      "type": "object", "required": ["prompt", "bpm"], "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string" },
        "bpm": { "type": "integer", "minimum": 40, "maximum": 180 },
        "duck_db": { "type": "number", "maximum": 0 }
      }
    },
    "shots": {
      "type": "array", "minItems": 8, "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "duration_s", "reason", "image_prompt", "motion_prompt", "characters", "narration", "music_cue"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]{2}$" },
          "duration_s": { "type": "number", "minimum": 3, "maximum": 12 },
          "reason": { "type": "string", "minLength": 10 },
          "image_prompt": { "type": "string", "minLength": 10 },
          "motion_prompt": { "type": "string", "minLength": 5 },
          "characters": { "type": "array", "items": { "type": "string" } },
          "seed": { "type": "integer" },
          "narration": {
            "type": "object", "required": ["text", "english"], "additionalProperties": false,
            "properties": { "text": { "type": "string" }, "english": { "type": "string" } }
          },
          "music_cue": { "type": "string", "enum": ["intro", "build", "warm", "quiet", "swell", "resolve"] }
        }
      }
    },
    "end_card": {
      "type": "object", "required": ["text", "duration_s"], "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "pattern": "AI" },
        "duration_s": { "type": "number", "minimum": 2 }
      }
    }
  }
}
